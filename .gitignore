# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- Pipeline working dirs & raw data (large; regenerate or re-fetch) ---
# (_data_real = fetch_volume.py output, real detail tier ~85 MB; _modal_out = volume dl)
pipeline/data_raw/
pipeline/_data_real/
pipeline/_modal_out/
pipeline/*.zip
pipeline/*.hdf5
pipeline/*.csv

# web/data/: full data (overview + detail) is committed and served same-origin by
# Pages — GitHub Release assets don't send CORS headers, so a cross-origin fetch
# of the detail tier from a Release is blocked. (A CORS object store like R2 is
# the path to move the detail tier off-repo when the dataset grows large.)

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Node (not used by this project, but just in case) ---
node_modules/

# --- Logs / temp ---
*.log
.cache/
